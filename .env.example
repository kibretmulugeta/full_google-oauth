# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (Used for CORS and redirects)
CLIENT_URL=http://localhost:5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/google_auth_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxx.mongodb.net/google_auth_db?retryWrites=true&w=majority

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Secret Key for Session Token Signing
JWT_SECRET=your_super_secret_jwt_key_change_in_production_12345
